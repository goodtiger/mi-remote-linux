[Unit]
Description=MiRemote RC003 voice input
After=graphical-session.target bluetooth.target
PartOf=graphical-session.target

[Service]
Type=simple
# Replace the project path before installing. Address is optional because RC003 is auto-detected.
ExecStart=/home/YOUR_USER/work/mi-remote-linux/.venv/bin/mi-remote voice --engine auto --grab-hid safe --inject
Restart=on-failure
RestartSec=3
TimeoutStopSec=20

[Install]
WantedBy=graphical-session.target
